# 本地开发密钥（复制为 .dev.vars 后填写）。生产环境用 GitHub Actions 部署时在 deploy.yml 里直接替换。

# JWT 签名密钥（任意长随机串，如 openssl rand -hex 32）
JWT_SECRET=change-me-to-a-long-random-string

# GitHub OAuth App（https://github.com/settings/developers 创建）
# Authorization callback URL 填: https://你的域名.com/auth/github/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Cloudflare API（用于子域名分发时自动创建/删除 DNS 记录）
# Token 需权限: Zone:DNS:Edit（Zone 资源限定到你的主域名 zone）
CF_API_TOKEN=
CF_ZONE_ID=
