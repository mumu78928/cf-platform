{
  "name": "yumingfenfa",
  "version": "1.0.0",
  "private": true,
  "description": "Cloudflare 二级域名分发系统 - 子域名管理、管理后台、OAuth登录、外接API、MCP接入",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "db:migrate:local": "wrangler d1 migrations apply yumingfenfa --local",
    "db:migrate:remote": "wrangler d1 migrations apply yumingfenfa --remote",
    "db:create-migration": "wrangler d1 migrations create yumingfenfa",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "hono": "^4.6.14",
    "bcryptjs": "^2.4.3",
    "@tsndr/cloudflare-worker-jwt": "^1.0.4"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20250109.0",
    "@types/bcryptjs": "^2.4.6",
    "typescript": "^5.7.2",
    "wrangler": "^3.99.0"
  }
}